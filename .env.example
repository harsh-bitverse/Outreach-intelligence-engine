# ==============================================================================
# OUTREACH INTELLIGENCE ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your values. NEVER commit .env to Git!

# Application Environment (DEVELOPMENT, STAGING, PRODUCTION)
APP_ENV=DEVELOPMENT
DEBUG=True

# Master Authoritative Excel Workbook Path
# Defaults to proud-planck database if present, or local data/ folder
MASTER_WORKBOOK_PATH=C:/Users/ch1251635/antigravity/proud-planck/Summer_2027_QS_Top_120_Professor_Research_Database.xlsx

# SQLite Database Location
SQLITE_DB_PATH=data/outreach_engine.db

# ------------------------------------------------------------------------------
# IIT Delhi Webmail Integration
# ------------------------------------------------------------------------------
# Official IMAP and SMTP Endpoints
IITD_IMAP_SERVER=mailstore.iitd.ac.in
IITD_IMAP_PORT=993
IITD_IMAP_USE_SSL=True

IITD_SMTP_SERVER=smtp.iitd.ac.in
IITD_SMTP_PORT=465
IITD_SMTP_USE_SSL=True

# Student Credentials (Never hardcode! Load from environment or OS keyring)
IITD_EMAIL_USER=ch1251635@iitd.ac.in
IITD_EMAIL_PASSWORD=

# ------------------------------------------------------------------------------
# Security, Sending Limits & Campaign Permissions
# ------------------------------------------------------------------------------
# Global Gateway Killswitch: Sending is strictly DISABLED by default
GATEWAY_ENABLED=False

# Dry Run Mode: When True, emails are validated and logged without actual SMTP transmission
DRY_RUN=True

# Explicit User Campaign Authorization (Must be set to True by the operator)
CAMPAIGN_AUTHORIZED=False

# IIT Delhi CSC Approval Acknowledged
IITD_CSC_APPROVED=False

# Sending Rate Limiting Controls
MAX_EMAILS_PER_BATCH=5
MAX_EMAILS_PER_DAY=25
MIN_INTERVAL_SECONDS_BETWEEN_EMAILS=30

# Emergency Stop Trigger
EMERGENCY_STOP=False

# ------------------------------------------------------------------------------
# Optional External LLM Integration
# ------------------------------------------------------------------------------
# The engine includes a high-precision deterministic template adapter by default.
# If an OpenAI-compatible API is available, provide the key below.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
